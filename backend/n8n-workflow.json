    {
      "parameters": {
        "jsCode": "let response = $json.choices[0].message.content;\n\n// Remove markdown if Groq accidentally returns it\nresponse = response.replace(/^```json\\s*/i, \"\");\nresponse = response.replace(/^```\\s*/i, \"\");\nresponse = response.replace(/\\s*```$/i, \"\");\nresponse = response.trim();\n\n// Parse JSON\nconst data = JSON.parse(response);\n\n// Default values\ndata.description = data.description || \"\";\ndata.tags = data.tags || [];\ndata.thumbnail_text = data.thumbnail_text || \"\";\n\n// Add scene numbers\nif (data.scenes && Array.isArray(data.scenes)) {\n    data.scenes.forEach((scene, index) => {\n        scene.scene = index + 1;\n    });\n}\n\nreturn [\n    {\n        json: data\n    }\n];"
      },
